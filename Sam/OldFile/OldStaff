//  package Assignment;

import java.util.ArrayList;
import java.util.Scanner;

public class staff1 {

    public void showmenu(String staffID, String name, String email, String phone) {
        UserInfo staffInfo = new UserInfo(staffID, "", name, email, phone);
        File_Modifier fm = new File_Modifier();
        boolean hasData = fm.initialize("PropertiesList.txt");

        ArrayList<Property> properties = new ArrayList<>();

   
        boolean logout = false;
        while (!logout) {
        if (hasData) {
            properties = fm.loadPropertiesData();
        }


        System.out.println("Welcome, " + staffID + "!");
        Scanner scanner = new Scanner(System.in);
  
        System.out.println("Properties List");
        System.out.println("===============");

        if (properties.isEmpty()) {
             System.out.println("No properties available.");
         } else {

   
        System.out.println("\n[ RESIDENTIAL PROPERTIES ]");
        System.out.println("\n");
        String resHeader = String.format("%-6s %-15s %-15s %-12s %-8s %-8s %-8s %-12s %-10s",
                "ID", "Location", "Type", "Price(RM)", "Sqft", "Beds", "Baths", "Garden", "Status");
        System.out.println(resHeader);
        System.out.println("=====================================================================================================");


        boolean hasResidential = false;
        for (Property prop : properties) {
            if (prop.getType() == Property.PropertyType.RESIDENTIAL) {
                ResidentialProperty rp = (ResidentialProperty) prop;
                String row = String.format("%-6s %-15s %-15s %-12s %-8.0f %-8d %-8d %-12s %-10s",
                        rp.getPropertyId(),
                        rp.getLocation(),
                        rp.getResidentialType(),
                        String.format("%.2f", rp.getListingPrice()),
                        rp.getSquareFootage(),
                        rp.getNumBedrooms(),
                        rp.getNumBathrooms(),
                        rp.hasGarden() ? "Yes" : "No",
                        rp.getStatus());
                System.out.println(row);
                hasResidential = true;
            }
        }
        if (!hasResidential) System.out.println("  No residential properties found.");
        System.out.println("\n");

        System.out.println("\n[ COMMERCIAL PROPERTIES ]");
        System.out.println("\n");System.out.println("\n");
        String comHeader = String.format("%-6s %-15s %-12s %-12s %-8s %-10s %-12s %-10s",
                "ID", "Location", "Type", "Price(RM)", "Sqft", "Parking", "LoadingDock", "Status");
        System.out.println(comHeader);
        System.out.println("===========================================================================================");

        boolean hasCommercial = false;
        for (Property prop : properties) {
            if (prop.getType() == Property.PropertyType.COMMERCIAL) {
                CommercialProperty cp = (CommercialProperty) prop;
                String row = String.format("%-6s %-15s %-12s %-12s %-8.0f %-10d %-12s %-10s",
                        cp.getPropertyId(),
                        cp.getLocation(),
                        cp.getCommercialType(),
                        String.format("%.2f", cp.getListingPrice()),
                        cp.getSquareFootage(),
                        cp.getNumParkingSpots(),
                        cp.getHasLoadingDock() ? "Yes" : "No",
                        cp.getStatus());
                System.out.println(row);
                hasCommercial = true;
            }
        }
        if (!hasCommercial) System.out.println("  No commercial properties found.");
    }
        
        System.out.println("\nStaff Menu:");
        System.out.println("1. View profile");
        System.out.println("2. Add properties");
        System.out.println("3. Edit properties");
        System.out.println("4. Logout");
        System.out.print("Choose: ");
        int choice = -1;

    try {
        choice = scanner.nextInt();
        scanner.nextLine();
        if (choice == 1) {
            staffInfo.displayInfo();
        }
        if (choice == 2) {
            Uni_method_list uml = new Uni_method_list("PropertiesList.txt");
            uml.addProperties(scanner);
        }
        if (choice == 3) {
            Uni_method_list uml = new Uni_method_list("PropertiesList.txt");
            uml.editProperties(scanner);
        }

        if (choice == 4) {
            System.out.println("Logging out...");
            logout = true;
        }
    } catch (Exception e) {
        System.out.println("Invalid input. Please enter a number between 1 and 4.");
        scanner.nextLine(); 
    }
    
}
}
}



    

