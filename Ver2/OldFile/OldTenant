import java.util.Scanner;
import java.util.InputMismatchException;
import java.io.IOException;
import java.io.File; 
import java.io.FileWriter;


public class Customer {
    private String username;
    // Add more fields if needed, e.g. for property info from PropertiesList.txt

    // Getter for username
    public String getUsername() {
        return username;
    }

    // Setter for username
    public void setUsername(String username) {
        this.username = username; 
    }

    public Customer(String username) {
        this.username = username;
    }

    // Initialize Customer from a properties file (example: PropertiesList.txt)
    public void initializeFromPropertiesFile(String propertyId, String filePath) {
        try {
            java.io.BufferedReader reader = new java.io.BufferedReader(new java.io.FileReader(filePath));
            String line;
            while ((line = reader.readLine()) != null) {
                String[] parts = line.split("\\|");
                if (parts.length > 0 && parts[0].equals(propertyId)) {
                    // Example: set username from properties file (customize as needed)
                    if (parts.length > 1) {
                        setUsername(parts[1]);
                    }
                    // Add more setters for other fields if needed
                    break;
                }
            }
            reader.close();
        } catch (IOException e) {
            System.out.println("Error reading properties file: " + e.getMessage());
        }
    }
    

    public void showMenu(Scanner scanner) {
        boolean logout = false;
        while (!logout) {
            System.out.println("\nCustomer Menu:");
            System.out.println("1. View profile");
            System.out.println("2. Logout");
            System.out.print("Choose: ");
            int choice = -1;
            try {
                choice = scanner.nextInt();
                scanner.nextLine();
            } catch (java.util.InputMismatchException e) {
                System.out.println("Invalid input. Please enter a number.");
                scanner.nextLine(); // clear invalid token
                continue;
            }
            if (choice == 1) {
                System.out.println("Profile:\n  Username: " + username);
            } else if (choice == 2) {
                System.out.println("Logging out...");
                logout = true;
            } else {
                System.out.println("Please select a valid option.");
            }
        }
    }
}
